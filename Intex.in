
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELITE ANDHR | GUILD WARS</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
 background:#080808;color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#111;padding:18px 5%;
 display:flex;justify-content:space-between;
 align-items:center;flex-wrap:wrap;gap:15px;
 border-bottom:2px solid #ff2929;
 position:sticky;top:0;z-index:10;
}
.logo{color:#ff2929;font-size:23px;font-weight:900}
nav a{
 color:white;text-decoration:none;
 margin:7px;font-size:13px;
}
nav a:hover{color:red}
.hero{
 min-height:440px;padding:100px 15px;
 text-align:center;
 background:linear-gradient(135deg,#300000,#080808,#240000);
}
.hero h1{
 font-size:clamp(40px,8vw,70px);
 color:#ff2929;text-shadow:0 0 20px red;
}
.hero p{color:#ddd;margin:20px 0;line-height:1.7}
.btn{
 display:inline-block;padding:14px 22px;
 margin:8px;background:#ff2929;color:white;
 border:0;border-radius:6px;text-decoration:none;
 font-weight:bold;cursor:pointer;
}
.btn:hover{background:#bd0000}
section{padding:60px 6%;text-align:center}
.heading{color:#ff2929;font-size:30px;margin-bottom:15px}
.sub{color:#aaa;margin-bottom:30px}
.cards{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
 gap:18px;margin-top:25px;
}
.card{
 background:#171717;border:1px solid #393939;
 padding:25px 15px;border-radius:12px;
 transition:.3s;
}
.card:hover{border-color:red;transform:translateY(-5px)}
.member-number{
 color:#ff3030;font-size:13px;font-weight:bold;
}
.member-name{
 font-size:19px;font-weight:bold;
 margin:14px 0;color:white;
 overflow-wrap:anywhere;
}
.points{color:#ffc928;font-size:16px;font-weight:bold}
.role{color:#aaa;font-size:12px;margin-top:8px}
table{
 width:100%;max-width:750px;margin:auto;
 border-collapse:collapse;background:#171717;
}
td,th{padding:14px 8px;border-bottom:1px solid #444}
th{background:#b90000;color:white}
tr:hover{background:#292020}
.social{
 display:flex;justify-content:center;
 flex-wrap:wrap;gap:12px;
}
footer{
 background:#111;padding:30px 10px;
 text-align:center;color:#aaa;
 border-top:2px solid red;line-height:2;
}
footer strong{color:#ff2929}
@media(max-width:600px){
 header{justify-content:center;text-align:center}
 nav a{font-size:12px;margin:5px}
 section{padding:45px 4%}
 .heading{font-size:25px}
}
</style>
</head>

<body>

